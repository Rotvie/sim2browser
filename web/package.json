    "@playwright/test": "1.63.0",
    "@types/node": "26.6.3",
    "@types/three": "0.186.0",
    "eslint": "10.11.0",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
